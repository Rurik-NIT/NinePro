{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?r=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?r=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?r=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?r=as"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/oauth?r=as"
    },
    {
      "source": "/api/oauth/:op",
      "destination": "/api/oauth?r=:op"
    },
    {
      "source": "/api/v1",
      "destination": "/api/v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/connect.ts": {
      "maxDuration": 300
    },
    "api/sync.ts": {
      "maxDuration": 300
    },
    "api/canais.ts": {
      "maxDuration": 300
    },
    "api/canais-webhook.ts": {
      "maxDuration": 60
    },
    "api/publicar.ts": {
      "maxDuration": 300
    },
    "api/regras.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/publicar",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/regras",
      "schedule": "20 * * * *"
    }
  ]
}