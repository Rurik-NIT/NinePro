# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (produção).

# --- Navegador (entram no bundle; são públicas por design, a segurança vem do RLS)
# Painel do Supabase → Project Settings → API
VITE_SUPABASE_URL=https://ztckmhdyhmrptjdtgejo.supabase.co
VITE_SUPABASE_ANON_KEY=
# "true" mostra "Criar conta" na tela de login. Em produção deixe vazio: acesso só por convite do admin.
VITE_ALLOW_SIGNUP=

# --- Servidor (SEM prefixo VITE_: nunca vai para o navegador)
# Usada só pelo painel admin (api/admin.ts). Painel do Supabase → Project Settings → API → service_role.
# Na Vercel, cadastre como "Sensitive". Nunca faça commit deste valor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrações (servidor)
# 32 bytes em base64 para criptografar tokens das plataformas: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Protege a sincronização diária (/api/sync) chamada pelo Vercel Cron
CRON_SECRET=
# Meta Ads — app criado em developers.facebook.com (Login do Facebook + Marketing API)
# URI de redirecionamento a cadastrar no app: https://SEU_DOMINIO/api/connect
META_APP_ID=
META_APP_SECRET=
# Opcionais
META_GRAPH_VERSION=v23.0
META_SCOPES=ads_read,ads_management,business_management
